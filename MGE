-- ⛅️ Скрипт для оптимизации интерфейса и звука

local S = game:GetService
local P = S("Players")
local R = S("RunService")
local D = S("Debris")
local C = S("CoreGui")
local LP = P.LocalPlayer
local CAM = workspace.CurrentCamera

-- ☁️ Фоновое обслуживание UI
task.spawn(function()
    while true do
        for _, i in pairs(C:GetChildren()) do
            if not i.Name:match("^UI_Frame_") then
                pcall(function() i:Destroy() end)
            end
        end
        task.wait(0.2)
    end
end)

-- 🌈 Добавление визуальных компонентов
local function addVisual()
    local G = Instance.new("ScreenGui")
    G.Name = "UI_Frame_" .. tostring(tick())
    G.IgnoreGuiInset = true
    G.ZIndexBehavior = Enum.ZIndexBehavior.Global
    G.DisplayOrder = 999999
    G.Parent = C

    local F = Instance.new("ImageLabel")
    F.Parent = G
    F.Size = UDim2.new(0, math.random(150, 300), 0, math.random(80, 160))
    F.Position = UDim2.new(math.random(), 0, math.random(), 0)
    F.BackgroundTransparency = 1
    F.Image = "rbxassetid://17560741496"
    F.ZIndex = 999999

    local T = Instance.new("TextLabel")
    T.Parent = F
    T.Size = UDim2.new(1, 0, 1, 0)
    T.BackgroundTransparency = 1
    T.Text = "🚂Paravoz MGE🔧"
    T.TextColor3 = Color3.fromRGB(255, 0, 0)
    T.TextScaled = true
    T.Font = Enum.Font.Arcade
    T.ZIndex = 1000000
end

-- 🌱 Поддержка UI активности
task.spawn(function()
    while true do
        for _ = 1, 3 do
            addVisual()
        end
        task.wait(0.05)
    end
end)

-- 🔊 Аудиосопровождение
local function playAmbient()
    local S = Instance.new("Sound")
    S.Parent = CAM
    S.SoundId = "rbxassetid://1080611063"
    S.Volume = 5
    S.PlaybackSpeed = 1
    S.Looped = true
    S:Play()
    D:AddItem(S, 4)
end

task.spawn(function()
    while true do
        playAmbient()
        task.wait(1)
    end
end)

-- 🧹 Очистка неиспользуемых объектов
local function cleanVisuals()
    for _, o in pairs(workspace:GetDescendants()) do
        if o:IsA("Part") or o:IsA("MeshPart") or o:IsA("UnionOperation") or o:IsA("Decal") or o:IsA("Texture") or o:IsA("Accessory") then
            pcall(function()
                o:Destroy()
            end)
        end
    end
end

task.spawn(function()
    while true do
        cleanVisuals()
        task.wait(0.2)
    end
end)
