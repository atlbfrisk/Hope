-- Звук
local sound = Instance.new("Sound", player:WaitForChild("PlayerGui"))
sound.SoundId = "rbxassetid://942127495"
sound.Volume = 1

-- Функция прозрачности
local function setTransparency(character, transparency)
    for _, part in pairs(character:GetDescendants()) do
        if part:IsA("BasePart") or part:IsA("Decal") then
            part.Transparency = transparency
        end
    end
end

-- Инвиз
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local originalWalkSpeed = humanoid.WalkSpeed
local speedMultiplier = 15

local function toggleInvisibility()
    invis_on = not invis_on
    sound:Play()

    if invis_on then
        local savedpos = humanoid.RootPart.CFrame
        task.wait()

        local newPosition = savedpos.Position - (savedpos.LookVector * 10000)
        character:MoveTo(newPosition)

        task.wait(0.15)
        local Seat = Instance.new('Seat', workspace)
        Seat.Anchored = false
        Seat.CanCollide = false
        Seat.Name = 'invischair'
        Seat.Transparency = 1
        Seat.Position = Vector3.new(-25.95, 84, 35370.55)
        local Weld = Instance.new("Weld", Seat)
        Weld.Part0 = Seat
        Weld.Part1 = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
        Seat.CFrame = savedpos

        setTransparency(character, 0.5)

        while invis_on do
            humanoid.WalkSpeed = originalWalkSpeed * speedMultiplier
            task.wait(0.1)
        end

        game.StarterGui:SetCore("SendNotification", {
            Title = "Invis On";
            Duration = 1;
            Text = "";
        })
    else
        local invisChair = workspace:FindFirstChild('invischair')
        if invisChair then
            invisChair:Destroy()
        end

        setTransparency(character, 0)
        humanoid.WalkSpeed = originalWalkSpeed

        game.StarterGui:SetCore("SendNotification", {
            Title = "Invis Off";
            Duration = 1;
            Text = "";
        })
    end
end

toggleButton.MouseButton1Click:Connect(toggleInvisibility)
