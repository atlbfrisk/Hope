
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local attachmentNames = {"1","2","3","4","5","6","7"}
local spacing = 2.5
local forwardAmplitude = 7
local moveSpeed = 1.2
local initialOffsetY = -2

local customOffsets = {
	[1] = Vector3.new(0, 0, 12.5),
	[2] = Vector3.new(-2.5, 0, 13.5),
	[3] = Vector3.new(2.5, 0, 16),
	[4] = Vector3.new(0, 0, 16),
	[5] = Vector3.new(0, 0, 16),
	[6] = Vector3.new(0, 0, 16),
	[7] = Vector3.new(0, 0, 16),
}

local character = player.Character or player.CharacterAdded:Wait()
local localRoot = character:WaitForChild("HumanoidRootPart")
local attachments = {}

local attachedTo = localRoot
local time = 0

local function initAttachmentsForRoot(root)
	attachments = {}
	for i, name in ipairs(attachmentNames) do
		local att = root:FindFirstChild(name)
		if att and att:IsA("Attachment") then
			local base = Vector3.new(0, initialOffsetY, -spacing * i)
			local custom = customOffsets[i] or Vector3.new(0,0,0)
			att.Position = base + custom
			table.insert(attachments, {
				index = i,
				ref = att,
				baseOffset = base,
				customOffset = custom,
			})
		else
			warn("Attachment '"..tostring(name).."' не найден в "..tostring(root))
		end
	end
end

initAttachmentsForRoot(localRoot)
attachedTo = localRoot

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "TailAttachGUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 240, 0, 260)
mainFrame.Position = UDim2.new(0.05, 0, 0.25, 0)
mainFrame.BackgroundColor3 = Color3.fromRGB(28,28,30)
mainFrame.BorderSizePixel = 0
mainFrame.Active = true
mainFrame.Draggable = true
mainFrame.Parent = screenGui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 30)
title.BackgroundColor3 = Color3.fromRGB(36,36,40)
title.BorderSizePixel = 0
title.Text = "Прикрепить хвост"
title.Font = Enum.Font.GothamBold
title.TextSize = 16
title.TextColor3 = Color3.fromRGB(225,225,225)
title.Parent = mainFrame

local playerList = Instance.new("ScrollingFrame")
playerList.Size = UDim2.new(1, -14, 1, -80)
playerList.Position = UDim2.new(0, 7, 0, 36)
playerList.BackgroundTransparency = 1
playerList.ScrollBarThickness = 6
playerList.Parent = mainFrame

local uiList = Instance.new("UIListLayout")
uiList.Padding = UDim.new(0,6)
uiList.Parent = playerList

local attachButton = Instance.new("TextButton")
attachButton.Size = UDim2.new(1, -14, 0, 36)
attachButton.Position = UDim2.new(0, 7, 1, -40)
attachButton.BackgroundColor3 = Color3.fromRGB(70,130,255)
attachButton.Font = Enum.Font.GothamBold
attachButton.TextSize = 15
attachButton.TextColor3 = Color3.new(1,1,1)
attachButton.Text = "Прикрепить"
attachButton.Parent = mainFrame

local selectedPlayer = nil
local buttonsByUserId = {}

uiList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
	playerList.CanvasSize = UDim2.new(0, 0, 0, uiList.AbsoluteContentSize.Y + 8)
end)

local function createButtonForPlayer(plr)
	if buttonsByUserId[plr.UserId] then return end
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -8, 0, 28)
	btn.BackgroundColor3 = Color3.fromRGB(44,44,50)
	btn.TextColor3 = Color3.fromRGB(230,230,230)
	btn.Font = Enum.Font.Gotham
	btn.TextSize = 14
	btn.Text = plr.Name
	btn.Parent = playerList

	btn.MouseButton1Click:Connect(function()
		if selectedPlayer and buttonsByUserId[selectedPlayer.UserId] then
			buttonsByUserId[selectedPlayer.UserId].BackgroundColor3 = Color3.fromRGB(44,44,50)
		end
		selectedPlayer = plr
		btn.BackgroundColor3 = Color3.fromRGB(90,130,255)
	end)

	buttonsByUserId[plr.UserId] = btn
end

local function removeButtonForPlayer(plr)
	local btn = buttonsByUserId[plr.UserId]
	if btn then
		btn:Destroy()
		buttonsByUserId[plr.UserId] = nil
		if selectedPlayer == plr then
			selectedPlayer = nil
		end
	end
end

for _, pl in ipairs(Players:GetPlayers()) do
	if pl ~= player then
		createButtonForPlayer(pl)
	end
end

Players.PlayerAdded:Connect(function(plr)
	if plr ~= player then
		createButtonForPlayer(plr)
	end
end)
Players.PlayerRemoving:Connect(function(plr)
	removeButtonForPlayer(plr)
end)

local function attachTailToRoot(targetRoot)
	if not targetRoot then return end

	for _, item in ipairs(attachments) do
		local att = item.ref
		if att then
			att.Parent = targetRoot
			local base = Vector3.new(0, initialOffsetY, -spacing * item.index)
			item.baseOffset = base
			att.Position = base + item.customOffset
		end
	end

	attachedTo = targetRoot
end

local function returnTailToLocal()
	local localChar = player.Character
	if not localChar then return end
	local localHRP = localChar:FindFirstChild("HumanoidRootPart")
	if not localHRP then return end

	for _, item in ipairs(attachments) do
		local att = item.ref
		if att then
			att.Parent = localHRP
			item.baseOffset = Vector3.new(0, initialOffsetY, -spacing * item.index)
			att.Position = item.baseOffset + item.customOffset
		end
	end
	attachedTo = localHRP
end

attachButton.MouseButton1Click:Connect(function()
	if not selectedPlayer then
		return
	end

	local tChar = selectedPlayer.Character
	local tRoot = (tChar and tChar:FindFirstChild("HumanoidRootPart")) and tChar.HumanoidRootPart or nil
	if not tRoot then
		warn("Нельзя прикрепить — у игрока нет HumanoidRootPart")
		return
	end

	attachTailToRoot(tRoot)

	if selectedPlayer then
		selectedPlayer.CharacterRemoving:Connect(function()
			returnTailToLocal()
		end)
	end
end)

RunService.RenderStepped:Connect(function(dt)
	if #attachments == 0 then return end
	time = time + dt * moveSpeed
	local globalZ = math.sin(time) * forwardAmplitude

	for _, item in ipairs(attachments) do
		local att = item.ref
		if att and att.Parent then
			local targetLocal = item.baseOffset + item.customOffset + Vector3.new(0, 0, globalZ)
			att.Position = targetLocal
		end
	end
end)

player.CharacterAdded:Connect(function(char)
	char:WaitForChild("HumanoidRootPart", 5)
	localRoot = char:FindFirstChild("HumanoidRootPart") or localRoot
	if attachedTo == nil or attachedTo == localRoot then
		returnTailToLocal()
	end
end)
