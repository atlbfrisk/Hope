-- Очистка скина (волосы не удаляются!)
local function clearAvatar(character)
	for _, item in ipairs(character:GetChildren()) do
		if item:IsA("Accessory") then
			local handle = item:FindFirstChild("Handle")
			if handle and handle:FindFirstChild("HairAttachment") then
				-- Волосы не удаляем
			else
				item:Destroy()
			end
		elseif item:IsA("Clothing") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("BodyColors") or item:IsA("ShirtGraphic") or item:IsA("CharacterMesh") then
			item:Destroy()
		end
	end
end

-- Методы для изменения скина
local function method_1(character, desc)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		pcall(function() humanoid:ApplyDescription(desc) end)
	end
end

local function method_2(character, appearance)
	if not (appearance and appearance:IsA("Model")) then return end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	
	for _, item in ipairs(appearance:GetChildren()) do
		if item:IsA("Accessory") and item:FindFirstChild("Handle") and humanoid then
			pcall(function()
				humanoid:AddAccessory(item:Clone())
			end)
		elseif item:IsA("Shirt") or item:IsA("Pants") or item:IsA("BodyColors") or item:IsA("ShirtGraphic") or item:IsA("CharacterMesh") then
			item:Clone().Parent = character
		end
	end
end

-- Основная функция для изменения скина
local function cloneAvatarById(userId)
	IdLabel.Text = "UserId: " .. userId
	
	local success, desc = pcall(function()
		return Players:GetHumanoidDescriptionFromUserId(userId)
	end)
	
	if not success or not desc then
		warn("❌ Не удалось получить описание Humanoid для UserId:", userId)
		return
	end
	
	-- Применить к себе
	local myChar = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	clearAvatar(myChar)
	method_1(myChar, desc)
	
	-- Задержка для надежности
	task.delay(1, function()
		local success2, appearance = pcall(function()
			return Players:GetCharacterAppearanceAsync(userId)
		end)
		
		if success2 and appearance then
			method_2(myChar, appearance)
		end
	end)
	
	-- Применить ко всем остальным игрокам
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local char = plr.Character
			if char then
				clearAvatar(char)
				
				-- Применяем оба метода для других игроков
				task.spawn(function()
					method_1(char, desc)
					
					task.wait(0.5)
					
					local success3, appearance = pcall(function()
						return Players:GetCharacterAppearanceAsync(userId)
					end)
					
					if success3 and appearance then
						method_2(char, appearance)
					end
				end)
			end
			
			-- Обработка появления нового персонажа у игрока
			plr.CharacterAdded:Connect(function(newChar)
				task.wait(1) -- Даем время на загрузку
				clearAvatar(newChar)
				method_1(newChar, desc)
				
				task.wait(0.5)
				
				local success4, appearance = pcall(function()
					return Players:GetCharacterAppearanceAsync(userId)
				end)
				
				if success4 and appearance then
					method_2(newChar, appearance)
				end
			end)
		end
	end
	
	print("✅ Скин применён: " .. userId)
end

