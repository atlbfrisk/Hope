-- Функция создания фиолетового сферического снаряда
local function createPurpleSphere()
    if not localPlayer.Character or not localPlayer.Character:FindFirstChild("HumanoidRootPart") then return end

    local rootPart = localPlayer.Character.HumanoidRootPart
    local startCFrame = rootPart.CFrame
    local startTime = tick()
    local followDuration = 1 -- Время следования за камерой (1 секунда)
    local direction = startCFrame.LookVector -- Начальное направление

    local settings = {
        Size = Vector3.new(30, 10, 30),
        Duration = 7, -- Общее время жизни снаряда
        Speed = 140,
        StartTransparency = 0.3,
        EndTransparency = 1,
        Material = Enum.Material.Neon,
        MainColor = Color3.fromRGB(138, 43, 226),
        LightColor = Color3.fromRGB(148, 0, 211)
    }

    local sphere = Instance.new("Part")
    sphere.Shape = Enum.PartType.Ball
    sphere.Size = settings.Size
    sphere.Anchored = true
    sphere.CanCollide = false
    sphere.Material = settings.Material
    sphere.Transparency = settings.StartTransparency
    sphere.Color = settings.MainColor

    local spawnOffset = startCFrame.LookVector * 5
    sphere.CFrame = startCFrame + spawnOffset + Vector3.new(0, 2, 0)
    sphere.Parent = workspace

    local pointLight = Instance.new("PointLight")
    pointLight.Brightness = 5.5
    pointLight.Range = 25
    pointLight.Color = settings.LightColor
    pointLight.Parent = sphere

    local particle = Instance.new("ParticleEmitter")
    particle.Texture = "rbxassetid://296874871"
    particle.LightEmission = 1
    particle.Color = ColorSequence.new(settings.MainColor)
    particle.Size = NumberSequence.new(0.5)
    particle.Speed = NumberRange.new(5)
    particle.Lifetime = NumberRange.new(0.5)
    particle.Rate = 50
    particle.Parent = sphere

    local connection
    connection = RunService.Heartbeat:Connect(function()
        local elapsed = tick() - startTime
        local progress = elapsed / settings.Duration

        if progress >= 1 then
            sphere:Destroy()
            connection:Disconnect()
            return
        end

        -- Первую секунду следим за направлением камеры
        if elapsed < followDuration then
            direction = localPlayer.Character.HumanoidRootPart.CFrame.LookVector
        end

        local moveOffset = direction * settings.Speed * elapsed
        sphere.Position = (startCFrame.Position + Vector3.new(0, 2, 0)) + moveOffset

        sphere.Transparency = settings.StartTransparency +
            (settings.EndTransparency - settings.StartTransparency) * progress

        pointLight.Brightness = 5 * (1 - progress)^2
        sphere.Size = settings.Size * (1 + 0.2 * math.sin(progress * 10))
    end)
end

