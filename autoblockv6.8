local autoBlockEnabled = false
local selectedPlayer = nil
local playerListFrame = nil

local function executeBlock()
    if currentBlocks <= 0 then return end
    
    local wasMouseVisible = UserInputService.MouseIconEnabled
    if wasMouseVisible then
        UserInputService.MouseIconEnabled = false
    end
    
    if currentBlocks == MAX_BLOCKS then
        firstBlockEndTime = os.clock() + BLOCK_DURATION
    end
    
    currentBlocks = currentBlocks - 1
    
    VirtualInputManager:SendKeyEvent(true, BLOCK_KEY, false, nil)
    task.delay(BLOCK_DURATION, function()
        VirtualInputManager:SendKeyEvent(false, BLOCK_KEY, false, nil)
        if wasMouseVisible then
            UserInputService.MouseIconEnabled = true
        end
        
        if os.clock() >= firstBlockEndTime then
            currentBlocks = MAX_BLOCKS
        end
    end)
end

local function shouldBlock(enemyRoot, root)
    local dist = (root.Position - enemyRoot.Position).Magnitude
    if dist > ACTIVATION_DIST then return false end
    
    local enemyDirection = enemyRoot.CFrame.LookVector
    local predictedPos = enemyRoot.Position + (enemyDirection * MOVE_DIST)
    return (root.Position - predictedPos).Magnitude <= HIT_RANGE
end

local function checkAttacks()
    if not autoBlockEnabled or not PLAYER.Character then return end
    
    local root = PLAYER.Character:FindFirstChild("HumanoidRootPart")
    local humanoid = PLAYER.Character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then return end

    local enemies = {}
    
    if selectedPlayer then
        if selectedPlayer ~= PLAYER and selectedPlayer.Character then
            table.insert(enemies, selectedPlayer)
        end
    else
        for _, enemy in ipairs(Players:GetPlayers()) do
            if enemy ~= PLAYER then
                table.insert(enemies, enemy)
            end
        end
    end

    for _, enemy in ipairs(enemies) do
        local enemyChar = enemy.Character
        if not enemyChar then continue end
        
        local enemyRoot = enemyChar:FindFirstChild("HumanoidRootPart")
        local enemyHumanoid = enemyChar:FindFirstChildOfClass("Humanoid")
        if not enemyRoot or not enemyHumanoid or enemyHumanoid.Health <= 0 then continue end

        if shouldBlock(enemyRoot, root) then
            for _, track in ipairs(enemyHumanoid:GetPlayingAnimationTracks()) do
                if track.Animation then
                    local animId = tonumber(track.Animation.AnimationId:match("%d+$"))
                    if animId and ATTACK_ANIMATIONS[animId] then
                        if track.TimePosition <= 0.1 then
                            executeBlock()
                            break
                        end
                    end
                end
            end
        end
    end
end

local function toggleAutoBlock()
    autoBlockEnabled = not autoBlockEnabled
    ToggleButton.Text = autoBlockEnabled and "Автоблок: ON" or "Автоблок: OFF"
    ToggleButton.BackgroundColor3 = autoBlockEnabled and Color3.fromRGB(80, 180, 80) or Color3.fromRGB(60, 60, 80)
end

local function createPlayerList()
    if playerListFrame then playerListFrame:Destroy() end
    
    playerListFrame = Instance.new("Frame")
    playerListFrame.Size = UDim2.new(0, 180, 0, 200)
    playerListFrame.Position = UDim2.new(0.5, -90, 1, 10)
    playerListFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    playerListFrame.Parent = MainFrame
    
    local scrollFrame = Instance.new("ScrollingFrame")
    scrollFrame.Size = UDim2.new(1, 0, 1, 0)
    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    scrollFrame.ScrollBarThickness = 5
    scrollFrame.BackgroundTransparency = 1
    scrollFrame.Parent = playerListFrame
    
    local layout = Instance.new("UIListLayout")
    layout.Parent = scrollFrame
    
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y)
    end)
    
    local allPlayersButton = Instance.new("TextButton")
    allPlayersButton.Size = UDim2.new(1, -10, 0, 30)
    allPlayersButton.Position = UDim2.new(0, 5, 0, 5)
    allPlayersButton.Text = "Все игроки"
    allPlayersButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    allPlayersButton.TextSize = 14
    allPlayersButton.Font = Enum.Font.Gotham
    allPlayersButton.BackgroundColor3 = Color3.fromRGB(70, 70, 90)
    allPlayersButton.Parent = scrollFrame
    
    allPlayersButton.MouseButton1Click:Connect(function()
        selectedPlayer = nil
        StatusLabel.Text = "Цель: Все игроки"
        playerListFrame:Destroy()
        playerListFrame = nil
    end)
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= PLAYER then
            local playerButton = Instance.new("TextButton")
            playerButton.Size = UDim2.new(1, -10, 0, 30)
            playerButton.Text = player.Name
            playerButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            playerButton.TextSize = 14
            playerButton.Font = Enum.Font.Gotham
            playerButton.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
            playerButton.Parent = scrollFrame
            
            playerButton.MouseButton1Click:Connect(function()
                selectedPlayer = player
                StatusLabel.Text = "Цель: " .. player.Name
                playerListFrame:Destroy()
                playerListFrame = nil
            end)
        end
    end
end

local function togglePlayerList()
    if playerListFrame then
        playerListFrame:Destroy()
        playerListFrame = nil
    else
        createPlayerList()
    end
end

ToggleButton.MouseButton1Click:Connect(toggleAutoBlock)
SelectPlayerButton.MouseButton1Click:Connect(togglePlayerList)

