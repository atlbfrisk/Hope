local function copyToClipboard(text, effectName)
    if toclipboard then
        toclipboard(text)
        print("✅ Скрипт '" .. effectName .. "' скопирован в буфер обмена!")
        for _, frame in pairs(script.Parent:GetDescendants()) do
            if frame:IsA("TextLabel") and frame.Text == effectName then
                local originalColor = frame.TextColor3
                frame.TextColor3 = Color3.new(0, 1, 0)
                wait(0.5)
                frame.TextColor3 = originalColor
                break
            end
        end
    else
        print("⚠️ Функция toclipboard недоступна")
        print("Текст для копирования:")
        print(string.rep("-", 40))
        print(text)
        print(string.rep("-", 40))
    end
end

